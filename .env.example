# Anthropic Claude API — primary AI provider (text, tool use, structured output)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional Claude model override; defaults to claude-sonnet-4-6 if unset
# Options: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
# CLAUDE_MODEL=claude-sonnet-4-6

# Google Gemini API — used only for audio transcription (Claude has no native audio)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override for audio; defaults to gemini-2.5-flash if unset
# GEMINI_MODEL=gemini-2.5-flash

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_BROADCAST_ENABLED=true
SUPABASE_PROGRESS_LOG_ENABLED=false

# Next.js
NODE_ENV=development

# Realtime + progress flags
NEXT_PUBLIC_SUPABASE_BROADCAST=true
# Set to true to also enable postgres_changes client subscription (optional fallback)
# NEXT_PUBLIC_SUPABASE_PG_CHANGES=false

# SSE progress streaming
NEXT_PUBLIC_ENABLE_SSE_PROGRESS=true
NEXT_PUBLIC_SSE_VERBOSE=true
