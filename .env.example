# Google Gemini API
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override; defaults to gemini-2.5-flash if unset
# GEMINI_MODEL=gemini-2.5-flash

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_BROADCAST_ENABLED=true
SUPABASE_PROGRESS_LOG_ENABLED=false

# Next.js
NODE_ENV=development

# Realtime + progress flags
NEXT_PUBLIC_SUPABASE_BROADCAST=true
# Set to true to also enable postgres_changes client subscription (optional fallback)
# NEXT_PUBLIC_SUPABASE_PG_CHANGES=false

# SSE progress streaming
NEXT_PUBLIC_ENABLE_SSE_PROGRESS=true
NEXT_PUBLIC_SSE_VERBOSE=true
