{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": ["react", "react-dom", "node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2018"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dev-archive",
    "wireframes",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.enhanced.ts",
    "src/**/*.refactored.ts",
    "src/**/*.minimal.tsx",
    "src/**/*.ultra-minimal.tsx",
    "src/components/editors/**",
    "src/components/StudentBioCard.tsx",
    "src/components/StructuredTiptapEditor.tsx",
    "src/components/NewReportForm.tsx",
    "src/components/MigrationPanel.tsx",
    "src/components/CompactAIAssistant.tsx",
    "src/components/FloatingAIAssistant.tsx",
    "src/components/dev/**"
  ]
}
